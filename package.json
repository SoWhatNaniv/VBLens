{
  "name": "vblens",
  "version": "1.1.0",
  "description": "Free and open-source disassembler and decompiler for Visual Basic 5/6 executables (native code and P-Code): desktop app with an MCP server for AI agents.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx tests/session-test.ts",
    "test:corpus": "tsx tests/corpus.ts",
    "decompile": "tsx tests/decomp.ts",
    "mcp": "tsx mcp/server.ts",
    "build:mcp": "node mcp/build.mjs",
    "test:mcp": "tsx mcp/smoke.ts",
    "test:mcp:corpus": "tsx mcp/corpus.ts",
    "desktop": "npm run build && npm run build:mcp && node desktop/build.mjs stage && electron build/app",
    "dist:win": "npm run build && npm run build:mcp && node desktop/build.mjs win32",
    "dist:linux": "npm run build && npm run build:mcp && node desktop/build.mjs linux",
    "test:unit": "tsx tests/unit-test.ts"
  },
  "keywords": [
    "visual basic",
    "vb6",
    "decompiler",
    "disassembler",
    "p-code",
    "reverse engineering",
    "malware analysis",
    "mcp",
    "ai",
    "electron"
  ],
  "author": "Niv (SoWhatNaniv)",
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.3.0",
    "esbuild": "^0.28.2",
    "resedit": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "private": true,
  "type": "module",
  "bin": {
    "vblens-mcp": "dist-mcp/vblens-mcp.mjs"
  },
  "engines": {
    "node": ">=20.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SoWhatNaniv/VBLens.git"
  },
  "homepage": "https://github.com/SoWhatNaniv/VBLens",
  "bugs": {
    "url": "https://github.com/SoWhatNaniv/VBLens/issues"
  }
}
